+# Boolean projection of lookup. Preserve its first match (including Absent)
+# and any BookCache boundary, without constructing missing definitions on lists.
+@unsafe
+def lookup_present(+book: List<&2,KDef>, +name: String) -> Bool:
+  match book:
+    case Nil{}: False{}
+    case Con{d, rest}:
+      kc(Bool, String.eq(dk(d), "BookCache"),
+        u => Bool.not(String.eq(dk(index_lookup(d, name)), "Absent")),
+        u => kc(Bool, String.eq(dn(d), name),
+          v => Bool.not(String.eq(dk(d), "Absent")), v => lookup_present(rest, name)))
+
