# The parent fallback recurses through this reset entry after every other
# statement/width pair. Branches retain the original branch renderer.
@unsafe
def p114so_stmts(body: List<&2,P113DStmt>, buffers: List<&2,String>, params: List<&2,NC_Binding>, ids: N111Ids, code: P111QCode) -> P111QCode:
  p114fl_stmts(body,buffers,params,ids,[],code)
