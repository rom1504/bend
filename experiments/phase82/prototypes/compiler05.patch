+    case Some{pieces}: NE_Parts{pieces}
+
+@unsafe
+def ne_runtime_prepend(runtime: NE_Runtime, prefix: String) -> NE_Runtime:
+  match runtime:
+    case NE_Text{text}: NE_Text{prefix ++ text}
+    case NE_Parts{parts}: ne_runtime_prefix(parts, prefix)
+
+@unsafe
