+/* Phase108: Linux ELF initializer for an admitted void(void) definition. */
+void
+emitconstructor(struct decl *d)
+{
+	static unsigned count;
+
+	printf("section \".init_array\"\ndata $.cproc.init.%u = align 8 { l ", ++count);
+	emitname(d->value);
+	fputs(" }\n", stdout);
+}
