+# The annotator stores the already-instantiated function telescope on every
+# App callee. Keep those existing App nodes rather than substituting each actual
+# through the remaining declaration type again. This path is saturated only;
+# missing annotations, unexpected shapes and a mismatched Ref retain the old
+# telescope walker. Every actual must also carry its producer annotation.
+@unsafe
+def jd_ordered_checked_args(+book: List<&2,KDef>, +env: List<&2,KTerm>, +t: KTerm,
+  +name: String, +xs: List<&2,KTerm>, +ty: KTerm, +next: U32) -> JDOrderedArgs:
+  jd_ordered_checked_args_on(book, env, xs, ty, next,
+    jd_ordered_typed_spine(t, name, terms_len(xs), Nil{}))
+
+@unsafe
+def jd_ordered_typed_spine(+t: KTerm, +name: String, +left: U32,
+  +apps: List<&2,KTerm>) -> Maybe<&2,List<&2,KTerm>>:
+  kc(Maybe<&2,List<&2,KTerm>>, String.eq(tg(t), "Ann") && U32.is_eq(terms_len(ks(t)), 2),
+    u => jd_ordered_typed_spine(kid(t, 0), name, left, apps), u =>
+  kc(Maybe<&2,List<&2,KTerm>>, String.eq(tg(t), "App") && U32.is_gt(left, 0) &&
+    U32.is_eq(terms_len(ks(t)), 2) &&
+    String.eq(tg(kid(t, 0)), "Ann") && U32.is_eq(terms_len(ks(kid(t, 0))), 2) &&
+    String.eq(tg(kid(kid(t, 0), 1)), "All") && U32.is_eq(terms_len(ks(kid(kid(t, 0), 1))), 2) &&
+    String.eq(tg(kid(t, 1)), "Ann") && U32.is_eq(terms_len(ks(kid(t, 1))), 2),
+    u => jd_ordered_typed_spine(kid(t, 0), name, U32.sub(left, 1), Con{t, apps}), u =>
+  kc(Maybe<&2,List<&2,KTerm>>, String.eq(tg(t), "Ref") && String.eq(nm(t), name) && U32.is_eq(left, 0),
+    u => Some{apps}, u => None{})))
+
+@unsafe
+def jd_ordered_checked_args_on(+book: List<&2,KDef>, +env: List<&2,KTerm>,
+  +xs: List<&2,KTerm>, +ty: KTerm, +next: U32, +result: Maybe<&2,List<&2,KTerm>>) -> JDOrderedArgs:
+  match result:
+    case None{}: jd_ordered_args(book, env, xs, ty, next)
+    case Some{apps}: jd_ordered_typed_args(book, env, apps, next)
+
+@unsafe
+def jd_ordered_typed_args(+book: List<&2,KDef>, +env: List<&2,KTerm>,
+  +apps: List<&2,KTerm>, +next: U32) -> JDOrderedArgs:
+  match apps:
+    case Nil{}: JDOrderedArgs{"", Nil{}, next}
+    case Con{t, rest}: kc(JDOrderedArgs, U32.is_eq(qt(kid(kid(t, 0), 1)), 0),
+      u => jd_ordered_typed_args(book, env, rest, next), u =>
+      jd_ordered_typed_arg_head(book, env, rest,
+        jd_ordered_expr(book, env, kid(t, 1), kid(kid(kid(t, 0), 1), 0), False{}, next)))
+
+@unsafe
+def jd_ordered_typed_arg_head(+book: List<&2,KDef>, +env: List<&2,KTerm>,
+  +rest: List<&2,KTerm>, +head: JDOrdered) -> JDOrderedArgs:
+  match head:
+    case JDOrdered{prefix, value, next}:
+      jd_ordered_arg_join(prefix, value, jd_ordered_typed_args(book, env, rest, next))
 
 # Eta expansion keeps supplied prefixes and expressions in the eventual fully
