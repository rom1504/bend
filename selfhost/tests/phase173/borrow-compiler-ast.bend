# Driver only. prepare-workload.py keeps the unchanged canonical KTerm,
# f_span_created, g_share_head, and all of their actual dependencies.
# No traversal or optimization implementation is replaced by this workload.
type P173BWReport is Data:
  P173BWReport{+located: List<&2,KTerm>, +shared: List<&2,GResult>, +replaced: KTerm}

# One eighth of leaves carry an existing origin. f_span_created must preserve
# those boundaries while locating every remaining node. The number/text pair
# and all immutable metadata remain independently visible in complete output.
def p173bwa_leaf_at(preserved: Bool, +seed: U32) -> KTerm:
  match preserved:
    case True{}: KLiteral{"U32",seed,U32.show(seed),71,79}
    case False{}: KLiteral{"U32",seed,U32.show(seed),0,0}

def p173bwa_leaf(+seed: U32) -> KTerm:
  p173bwa_leaf_at(U32.is_eq(U32.and(seed,7),0),seed)

# Each child is generated by a separate recursive invocation with a distinct
# seed. There is no exponentially repeated shared subtree. Construction depth
# is twelve, independent of the number of nodes returned by the compiler walk.
@unsafe
def p173bwa_tree(+depth: Nat, +seed: U32) -> KTerm:
  match depth:
    case 0n: p173bwa_leaf(seed)
    case 1n+p:
      KTerm{"Ctr",U32.show(seed),seed,U32.and(seed,1),
        [p173bwa_tree(p,U32.mul(seed,2)),
         p173bwa_tree(p,U32.inc(U32.mul(seed,2)))],
        ["retain-node-note"],0,0}

def p173bwa_result() -> P173BWReport:
  +alias = p173bwa_tree(4n,3)
  P173BWReport{[alias],
    [g_share_head(GState{GEmpty{},1},
      f_span_created(KTerm{"Ctr","root",1,2,
        [alias,p173bwa_tree(12n,1)],["retain-root-note"],0,0},11,49))],
    KLiteral{"U32",8223,"nodes-before-sharing",0,0}}
