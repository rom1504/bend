{
  "kind": "phase176-independent-jobs",
  "version": 1,
  "inputs": [],
  "jobs": [
    {
      "id": "base",
      "seconds": 60,
      "command": [
        "selfhost/.assets/bin/bun",
        "selfhost/tools/build/hosted.mjs",
        "acquire",
        "--source",
        "selfhost/build/phase178/parser-base-source01/compiler.bend",
        "--exports",
        "selfhost/build/phase178/parser-base-source01/exports.json",
        "--upstream",
        "selfhost/.bootstrap/upstream-phase66",
        "--engine",
        "selfhost/.assets/bin/bun",
        "--out",
        "{out}"
      ]
    },
    {
      "id": "candidate",
      "seconds": 60,
      "command": [
        "selfhost/.assets/bin/bun",
        "selfhost/tools/build/hosted.mjs",
        "acquire",
        "--source",
        "selfhost/build/phase178/parser-candidate-source01/compiler.bend",
        "--exports",
        "selfhost/build/phase178/parser-candidate-source01/exports.json",
        "--upstream",
        "selfhost/.bootstrap/upstream-phase66",
        "--engine",
        "selfhost/.assets/bin/bun",
        "--out",
        "{out}"
      ]
    }
  ]
}
