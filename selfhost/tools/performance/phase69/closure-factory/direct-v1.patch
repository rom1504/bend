+# Known partial calls need no curried factory when the actual body starts with
+# the complete live lambda telescope. This syntactic condition preserves raw
+# demand/error order independently of a declared function type.
+@unsafe
+def nd_partial_ok(+book: List<&2, KDef>, +head: KTerm, +count: U32) -> Bool:
+  +d = lookup(book, nm(head))
+  +arity = nd_arity(book, nm(head))
+  Bool.not(U32.is_eq(qt(head), 3)) && String.eq(dk(d), "Def") && Bool.not(nc_native_def(d)) && Bool.not(nc_foreign(d)) && U32.is_gt(count, 0) && U32.is_lt(count, arity) && U32.is_eq(nd_leading(dv(d), 0), arity)
+
+# Sequence captures before closing over them. Reserve every capture/parameter ID
+# before ordinary lowering; reuse its sharing, disposal and closure environment.
+@unsafe
+def nd_partial_term(+name: String, args: List<&2, KTerm>, +acc: List<&2, KTerm>, +n: U32, +left: U32) -> KTerm:
+  match args:
+    case Nil{}:
+      +params = nd_entry_params(left, n)
+      nd_eta_body(params, kt("NCall", name, 0, 0, List.append(&2, KTerm, nt_reverse(KTerm, acc, Nil{}), nd_entry_args(params))))
+    case Con{+h, rest}:
+      nc_mklet(nc_id(n), h, nd_partial_term(name, rest, Con{var("", nc_id(n)), acc}, U32.inc(n), left))
+
+@unsafe
+def nd_partial_to(+book: List<&2, KDef>, +head: KTerm, +args: List<&2, KTerm>, +env: List<&2, NC_Binding>, +n: U32, +target: NC_Target) -> NC_Code:
