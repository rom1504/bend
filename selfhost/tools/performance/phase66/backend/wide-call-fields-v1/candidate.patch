+# Count live constructor fields with the same finite work budget as the body
+# scan. Wide records do not need a separate arbitrary arity ceiling. Erased
+# telescope slots still consume work; no partial graph survives exhaustion.
+@unsafe
+def jd_calls_match_fields(+book: List<&2,KDef>, +env: List<&2,KTerm>, +t: KTerm,
+  +ty: KTerm, +args: U32, +tel: KTerm, +s: JDCallScan) -> JDCallScan:
+  match s:
+    case JDCallScan{edges, unknown, fuel, valid}:
+      kc(JDCallScan, String.eq(tg(tel), "All"), u =>
+        kc(JDCallScan, valid && U32.is_gt(fuel, 0), v =>
+          jd_calls_match_fields(book, env, t, ty,
+            U32.add(args, kc(U32, U32.is_eq(qt(tel), 0), w => 0, w => 1)), kid(tel, 1),
+            JDCallScan{edges, unknown, U32.sub(fuel, 1), valid}), v => jd_calls_bad(s)),
+        u => jd_calls_body(book, env, t, ty, args, s))
 
