+# PRIVATE context for the successful result of this same admitted world check.
+# The driver couples that result, load and prepared seed; a raw book supplied by
+# a public caller does not acquire this permission. Public book_context is intact.
+@unsafe
+def book_context_world(+book: List<&2,KDef>, +load: FPrefixLoad, +prepared: KBasePreparedWorld) -> List<&2,KDef>:
+  match load:
+    case FPrefixLoad{trace, prefix, suffix, ready}:
+      match trace:
+        case FLoadTrace{result, done, sources}:
+          match result:
+            case FResult{original, error, imports}:
+              base_prefix_context_world(book, error, suffix, ready, prepared)
+
+@unsafe
+def base_prefix_context_world(+book: List<&2,KDef>, +error: String, +suffix: List<&2,KDef>, +ready: Bool, +prepared: KBasePreparedWorld) -> List<&2,KDef>:
+  match prepared:
+    case KBasePreparedWorld{state, original, final, saved, checked, seen, todos, checkedBound}:
+      +bound = norm_max(base_prefix_world_bound(state), norm_max_book(suffix))
+      kc(List<&2,KDef>, ready && String.is_empty(error) && Bool.not(String.eq(dk(index_first(book)), "BookCache")) &&
+        base_prefix_world_admitted(state, suffix, bound, final, saved) &&
+        base_prefix_world_hash_disjoint(suffix, index_first(dc(index_first(saved)))),
+        u => base_prefix_context_tail(book, checkedBound, base_prefix_context_drop(book, checked)),
+        u => book_context(book))
+
+# Checking only prepends output to the saved reverse checked list. Reversing the
+# result therefore preserves its entire original checked prefix, in forward
+# order. Count the known prefix cells; do not rescan their immutable term trees.
+@unsafe
+def base_prefix_context_drop(+book: List<&2,KDef>, +prefix: List<&2,KDef>) -> KBasePrefixTail:
+  match prefix:
+    case Nil{}: KBasePrefixTail{book, True{}}
+    case Con{d, rest}: base_prefix_context_drop_head(book, rest)
+
+@unsafe
+def base_prefix_context_drop_head(+book: List<&2,KDef>, +prefix: List<&2,KDef>) -> KBasePrefixTail:
+  match book:
+    case Nil{}: KBasePrefixTail{Nil{}, False{}}
+    case Con{d, rest}: base_prefix_context_drop(rest, prefix)
+
+@unsafe
+def base_prefix_context_tail(+book: List<&2,KDef>, +checkedBound: U32, +tail: KBasePrefixTail) -> List<&2,KDef>:
+  match tail:
+    case KBasePrefixTail{suffix, matched}:
+      kc(List<&2,KDef>, matched,
+        u => book_cached(book, norm_max(checkedBound, norm_max_book(suffix))),
+        u => book_context(book))
