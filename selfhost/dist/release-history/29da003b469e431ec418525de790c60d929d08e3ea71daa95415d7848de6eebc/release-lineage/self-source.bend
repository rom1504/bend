def jir_lower_fields(+book: List<&2,KDef>, +env: List<&2,KTerm>, +fields: List<&2,KTerm>, +tel: KTerm, +tail: Bool) -> List<&2,JIRExpr>:
  match fields:
    case Nil{}: Nil{}
    case Con{field, rest}:
      Con{jir_lower_argument(book, env, field, tel, tail),
        jir_lower_fields(book, env, rest, j_app_type(tel, field), tail)}

# Operation selection is separate from printing: the caller has established
# exact native definition identity, saturation and the complete live telescope.
# Literal shifts retain the prior no-coercion rule for counts above 31.

# Module: src/back/js/ir/lower.bend:149
@unsafe
def jir_lower_primitive(+book: List<&2,KDef>, +env: List<&2,KTerm>, +spine: KTerm) -> JIRExpr:
  +name = nm(spine)
  +a = jir_lower(book, env, kid(spine, 0), kt("ADT", j_primitive_input(name, 0), 0, 0, Nil{}), False{})
  +count = j_strip(kid(spine, 1))
  kc(JIRExpr, (String.eq(name, "U32.shln") || String.eq(name, "U32.shrn")) && core_nat(count),
    u => JIRShift{name, a, kl_number(count)},
    u => JIRPrimitive{name, a, kc(JIRExpr, U32.is_eq(j_primitive_arity(name), 2),
      u => jir_lower(book, env, kid(spine, 1), kt("ADT", j_primitive_input(name, 1), 0, 0, Nil{}), False{}),
      u => JIRNull{})})

# Module: src/back/js/ir/control.bend:6
@unsafe
def jir_lower_choice(+book: List<&2,KDef>, +env: List<&2,KTerm>, +spine: KTerm, +tail: Bool) -> JIRExpr:
  +args = ks(spine)
  +conditionType = wnf(book, j_app_type(wnf(book, dt(lookup(book, nm(spine)))), terms_at(args, 0)))
  +branchType = wnf(book, j_app_type(conditionType, terms_at(args, 1)))
  JIRChoice{
    jir_lower(book, env, terms_at(args, 1), kid(conditionType, 0), False{}),
    jir_lower_choice_branch(book, env, j_strip(terms_at(args, 2)), wnf(book, kid(branchType, 0)), tail),
    jir_lower_choice_branch(book, env, j_strip(terms_at(args, 3)),
      wnf(book, kid(wnf(book, j_app_type(branchType, terms_at(args, 2))), 0)), tail)}

# Module: src/back/js/ir/control.bend:17
@unsafe
def jir_lower_choice_branch(+book: List<&2,KDef>, +env: List<&2,KTerm>, +t: KTerm, +ty: KTerm, +tail: Bool) -> JIRExpr:
  +erased = U32.is_eq(qt(ty), 0)
  JIRLet{[JIRParam{ix(t), erased}],
    [kc(JIRExpr, erased, u => JIRNull{}, u => JIRConstruct{"Unit", Nil{}, False{}})],
    jir_lower(book, Con{kt("Env", "", ix(t), 0, [kid(ty, 0)]), env}, kid(t, 0),
      subst(kid(ty, 1), ix(ty), var(nm(t), ix(t))), tail)}

# Module: src/back/js/ir/facts.bend:8
@unsafe
def jir_copy_lookup(+copies: List<&2, JIRCopy>, +id: U32) -> JIRExpr:
  match copies:
    case Nil{}: JIRLocal{id}
    case Con{JIRCopy{key, value}, rest}:
      kc(JIRExpr, U32.is_eq(key, id), u => value, u => jir_copy_lookup(rest, id))

# Module: src/back/js/ir/facts.bend:15
@unsafe
def jir_copy_reads(+value: JIRExpr, +id: U32) -> Bool:
  match value:
    case JIRLocal{key}: U32.is_eq(key, id)
    case other: False{}

# Shadowing invalidates both the copied binder and its ultimate source. This
# matters even with normally unique IDs: synthetic backend inputs may shadow.

# Module: src/back/js/ir/facts.bend:23
@unsafe
def jir_copy_shadow(+copies: List<&2, JIRCopy>, +id: U32) -> List<&2, JIRCopy>:
  match copies:
    case Nil{}: Nil{}
    case Con{JIRCopy{key, value}, rest}:
      kc(List<&2, JIRCopy>, U32.is_eq(key, id) || jir_copy_reads(value, id),
        u => jir_copy_shadow(rest, id), u => Con{JIRCopy{key, value}, jir_copy_shadow(rest, id)})

# Module: src/back/js/ir/facts.bend:31
@unsafe
def jir_copy_scope(+copies: List<&2, JIRCopy>, +params: List<&2, JIRParam>) -> List<&2, JIRCopy>:
  match params:
    case Nil{}: copies
    case Con{param, rest}: jir_copy_scope(jir_copy_shadow(copies, jir_param_id(param)), rest)

# Module: src/back/js/ir/facts.bend:37
@unsafe
def jir_copy_take(+copies: List<&2, JIRCopy>, +left: U32) -> List<&2, JIRCopy>:
  match copies:
    case Nil{}: Nil{}
    case Con{copy, rest}:
      kc(List<&2, JIRCopy>, U32.is_eq(left, 0), u => Nil{},
        u => Con{copy, jir_copy_take(rest, U32.sub(left, 1))})

# Module: src/back/js/ir/facts.bend:45
@unsafe
def jir_param_has(+params: List<&2, JIRParam>, +id: U32) -> Bool:
  match params:
    case Nil{}: False{}
    case Con{param, rest}:
      kc(Bool, U32.is_eq(jir_param_id(param), id), u => True{}, u => jir_param_has(rest, id))

# Parallel RHSs refer to the outer scope. A source local rebound anywhere in
# this Let therefore cannot replace a body local after the new scope opens.

# Module: src/back/js/ir/facts.bend:54
@unsafe
def jir_copy_admit(+value: JIRExpr, +params: List<&2, JIRParam>) -> Bool:
  match value:
    case JIRLocal{id}: Bool.not(jir_param_has(params, id))
    case JIRNull{}: True{}
    case other: False{}

# At most 64 facts survive, and at most 64 bindings are candidates per scope.
# Larger scopes remain correct and simply receive less propagation. Together
# with scope invalidation this bounds work by a constant times the IR surface.

# Module: src/back/js/ir/facts.bend:64
@unsafe
def jir_copy_bind(+params: List<&2, JIRParam>, +values: List<&2, JIRExpr>, +scope: List<&2, JIRParam>, +copies: List<&2, JIRCopy>, +left: U32) -> List<&2, JIRCopy>:
  match params:
    case Nil{}: copies
    case Con{param, rest}:
      match values:
        case Nil{}: copies
        case Con{value, more}:
          kc(List<&2, JIRCopy>, U32.is_eq(left, 0), u => copies, u =>
            jir_copy_bind(rest, more, scope,
              kc(List<&2, JIRCopy>, jir_copy_admit(value, scope),
                u => Con{JIRCopy{jir_param_id(param), value}, jir_copy_take(copies, 63)}, u => copies),
              U32.sub(left, 1)))

# Module: src/back/js/ir/constants.bend:6
@unsafe
def jir_fold_primitive(+name: String, +a: JIRExpr, +b: JIRExpr) -> JIRExpr:
  jir_fold_primitive_on(name, a, b, JIRPrimitive{name, a, b})

# Module: src/back/js/ir/constants.bend:10
@unsafe
def jir_fold_primitive_on(+name: String, +a: JIRExpr, +b: JIRExpr, +original: JIRExpr) -> JIRExpr:
  match a:
    case JIRWord{x, False{}}:
      match b:
        case JIRWord{y, False{}}: jir_fold_binary(name, x, y, original)
        case JIRNull{}: jir_fold_unary(name, x, original)
        case other: original
    case other: original

# Module: src/back/js/ir/constants.bend:20
@unsafe
def jir_fold_binary(+name: String, +x: U32, +y: U32, +original: JIRExpr) -> JIRExpr:
  kc(JIRExpr, String.eq(name, "U32.add"), u => JIRWord{U32.add(x, y), False{}}, u =>
  kc(JIRExpr, String.eq(name, "U32.sub"), u => JIRWord{U32.sub(x, y), False{}}, u =>
  kc(JIRExpr, String.eq(name, "U32.and"), u => JIRWord{U32.and(x, y), False{}}, u =>
  kc(JIRExpr, String.eq(name, "U32.or"), u => JIRWord{U32.or(x, y), False{}}, u =>
  kc(JIRExpr, String.eq(name, "U32.xor"), u => JIRWord{U32.xor(x, y), False{}}, u => original)))))

# Module: src/back/js/ir/constants.bend:28
@unsafe
def jir_fold_unary(+name: String, +x: U32, +original: JIRExpr) -> JIRExpr:
  kc(JIRExpr, String.eq(name, "U32.inc"), u => JIRWord{U32.inc(x), False{}}, u =>
  kc(JIRExpr, String.eq(name, "U32.not"), u => JIRWord{U32.not(x), False{}}, u =>
  kc(JIRExpr, String.eq(name, "U32.shl"), u => JIRWord{U32.shl(x), False{}}, u =>
  kc(JIRExpr, String.eq(name, "U32.shr"), u => JIRWord{U32.shr(x), False{}}, u => original))))

# Module: src/back/js/ir/simplify.bend:6
@unsafe
def jir_simplify_many(+terms: List<&2, JIRExpr>, +copies: List<&2, JIRCopy>) -> List<&2, JIRExpr>:
  match terms:
    case Nil{}: Nil{}
    case Con{term, rest}: Con{jir_simplify_with(term, copies), jir_simplify_many(rest, copies)}

# Module: src/back/js/ir/simplify.bend:12
@unsafe
def jir_simplify_let(+params: List<&2, JIRParam>, +values: List<&2, JIRExpr>, +body: JIRExpr, +copies: List<&2, JIRCopy>) -> JIRExpr:
  +rewritten = jir_simplify_many(values, copies)
  jir_simplify_let_select(params, rewritten, body, copies)

# An identity binding evaluates its sole RHS once and returns that exact value.
# Inspect the original body before copy propagation changes a Local/Null alias.
# Reuse the RHS node unchanged: in particular a non-tail application stays
# demanded, and an eager constructor never becomes a deferred tail constructor.
# The RHS already has the outer scope, including when its ID shadows this Let.

# Module: src/back/js/ir/simplify.bend:22
@unsafe
def jir_simplify_let_select(+params: List<&2, JIRParam>, +values: List<&2, JIRExpr>, +body: JIRExpr, +copies: List<&2, JIRCopy>) -> JIRExpr:
  match params:
    case Con{param, Nil{}}:
      match values:
        case Con{value, Nil{}}:
          match body:
            case JIRLocal{id}:
              kc(JIRExpr, U32.is_eq(jir_param_id(param), id), u => value,
                u => jir_simplify_let_body(params, values, body, copies))
            case other: jir_simplify_let_body(params, values, body, copies)
        case other: jir_simplify_let_body(params, values, body, copies)
    case other: jir_simplify_let_body(params, values, body, copies)

# Module: src/back/js/ir/simplify.bend:36
@unsafe
def jir_simplify_let_body(+params: List<&2, JIRParam>, +rewritten: List<&2, JIRExpr>, +body: JIRExpr, +copies: List<&2, JIRCopy>) -> JIRExpr:
  +inner = jir_copy_bind(params, rewritten, params, jir_copy_scope(copies, params), 64)
  JIRLet{params, rewritten, jir_simplify_with(body, inner)}

# Module: src/back/js/ir/simplify.bend:41
@unsafe
def jir_simplify_with(+t: JIRExpr, +copies: List<&2, JIRCopy>) -> JIRExpr:
  match t:
    case JIRLocal{id}: jir_copy_lookup(copies, id)
    case JIRApply{callee, args, tail}:
      JIRApply{jir_simplify_with(callee, copies), jir_simplify_many(args, copies), tail}
    case JIRConstruct{name, fields, tail}:
      JIRConstruct{name, jir_simplify_many(fields, copies), tail}
    case JIRPrimitive{name, a, b}:
      jir_fold_primitive(name, jir_simplify_with(a, copies), jir_simplify_with(b, copies))
    case JIRShift{name, left, count}:
      JIRShift{name, jir_simplify_with(left, copies), count}
    case JIRLet{params, values, body}: jir_simplify_let(params, values, body, copies)
    case JIRLambda{params, body}:
      JIRLambda{params, jir_simplify_with(body, jir_copy_scope(copies, params))}
    case JIRMatch{name, single, arm, fallback}:
      JIRMatch{name, single, jir_simplify_with(arm, copies), jir_simplify_with(fallback, copies)}
    case JIRChoice{condition, yes, no}:
      JIRChoice{jir_simplify_with(condition, copies), jir_simplify_with(yes, copies), jir_simplify_with(no, copies)}
    case JIRCallPlan{env, spine, fallback}:
      JIRCallPlan{env, spine, jir_simplify_with(fallback, copies)}
    case other: t

# Module: src/back/js/ir/simplify.bend:64
@unsafe
def jir_simplify(+t: JIRExpr) -> JIRExpr:
  jir_simplify_with(t, Nil{})

# Module: src/back/js/ir/emit.bend:3
@unsafe
def jir_compile(+book: List<&2,KDef>, +node: JIRExpr) -> String:
  jir_emit(book, jir_simplify(node))

# Print explicit operations. This layer makes no type, arity or purity guesses;
# inherited specialized plans are isolated behind the two compatibility nodes.

# Module: src/back/js/ir/emit.bend:9
@unsafe
def jir_emit(+book: List<&2,KDef>, +node: JIRExpr) -> String:
  match node:
    case JIRLocal{id}: j_local(id)
    case JIRGlobal{name}: "get(G," ++ j_quote(name) ++ ")"
    case JIRNull{}: "null"
    case JIRWord{number, float}: j_word_text(Some{number}, float)
    case JIRNat{number}: U32.show(number) ++ "n"
    case JIRString{text}: j_quote(text)
    case JIRConstruct{name, fields, tail}:
      kc(String, tail, u => "build(", u => "ctor(") ++ j_quote(name) ++ ",[" ++
        kc(String, tail, u => jir_emit_thunks(book, fields), u => jir_emit_values(book, fields)) ++ "])"
    case JIRPrimitive{name, a, b}:
      "(/* primitive */" ++ j_primitive_code(name, "(" ++ jir_emit(book, a) ++ ")",
        "(" ++ kc(String, U32.is_eq(j_primitive_arity(name), 2), u => jir_emit(book, b), u => "") ++ ")") ++ ")"
    case JIRShift{name, left, count}:
      "(/* primitive */" ++ j_primitive_shift_literal(name, "(" ++ jir_emit(book, left) ++ ")", count) ++ ")"
    case JIRChoice{condition, yes, no}:
      "(/* choice */" ++ jir_emit(book, condition) ++ "?" ++ jir_emit(book, yes) ++ ":" ++ jir_emit(book, no) ++ ")"
    case JIRApply{callee, args, tail}:
      kc(String, tail, u => "jump(", u => "callOwned(") ++ jir_emit(book, callee) ++ ",[" ++
        jir_emit_apply_args(book, args) ++ "])"
    case JIRLet{params, values, body}:
      "((" ++ jir_emit_params(params) ++ ")=>" ++ jir_emit(book, body) ++ ")(" ++ jir_emit_values(book, values) ++ ")"
    case JIRLambda{params, body}:
      "fn(" ++ U32.show(jir_emit_arity(params)) ++ ",function(a){" ++ jir_emit_lambda_bindings(params, 0) ++
        jir_emit_return(book, body) ++ "})"
    case JIRMatch{name, single, arm, fallback}:
      kc(String, single, u => "matcher1(", u => "matcher(") ++ j_quote(name) ++ ",()=>" ++ jir_emit(book, arm) ++
        kc(String, single, u => "", u => ",()=>" ++ jir_emit(book, fallback)) ++ ")"
    case JIRCallPlan{env, spine, fallback}: j_finite_call(book, env, spine, jir_emit(book, fallback))
    case JIRLegacy{env, term, typ, tail}: j_expr_legacy(book, env, term, typ, tail)

# Module: src/back/js/ir/emit.bend:42
@unsafe
def jir_emit_arity(+params: List<&2,JIRParam>) -> U32:
  match params:
    case Nil{}: 0
    case Con{param, rest}: U32.inc(jir_emit_arity(rest))

# Module: src/back/js/ir/emit.bend:48
@unsafe
def jir_emit_params(+params: List<&2,JIRParam>) -> String:
  match params:
    case Nil{}: ""
    case Con{param, rest}: j_local(jir_param_id(param)) ++ "," ++ jir_emit_params(rest)

# Module: src/back/js/ir/emit.bend:54
@unsafe
def jir_emit_values(+book: List<&2,KDef>, +values: List<&2,JIRExpr>) -> String:
  match values:
    case Nil{}: ""
    case Con{value, rest}: jir_emit(book, value) ++ "," ++ jir_emit_values(book, rest)

# Module: src/back/js/ir/emit.bend:60
@unsafe
def jir_emit_thunks(+book: List<&2,KDef>, +values: List<&2,JIRExpr>) -> String:
  match values:
    case Nil{}: ""
    case Con{value, rest}: "()=>" ++ jir_emit(book, value) ++ "," ++ jir_emit_thunks(book, rest)

# Preserve the historical output spelling while exposing a uniform IR list:
# a one-step application has no trailing comma; a grouped prefix has one.

# Module: src/back/js/ir/emit.bend:68
@unsafe
def jir_emit_apply_args(+book: List<&2,KDef>, +args: List<&2,JIRExpr>) -> String:
  match args:
    case Nil{}: ""
    case Con{arg, Nil{}}: jir_emit(book, arg)
    case Con{arg, rest}: jir_emit_values(book, args)

# Module: src/back/js/ir/emit.bend:75
@unsafe
def jir_emit_lambda_bindings(+params: List<&2,JIRParam>, +at: U32) -> String:
  match params:
    case Nil{}: ""
    case Con{param, rest}:
      "const " ++ j_local(jir_param_id(param)) ++ "=" ++
        kc(String, jir_param_erased(param), u => "null", u => "a[" ++ U32.show(at) ++ "]") ++ ";" ++
        jir_emit_lambda_bindings(rest, U32.inc(at))

# Module: src/back/js/ir/statement.bend:10
@unsafe
def jir_emit_return(+book: List<&2,KDef>, +node: JIRExpr) -> String:
  match node:
    case JIRLet{params, values, body}:
      "{" ++ jir_statement_values(book, values, 0) ++ "{" ++
        jir_statement_bindings(params, 0) ++ jir_emit_return(book, body) ++ "}}"
    case JIRChoice{condition, yes, no}:
      "/* choice */if(" ++ jir_emit(book, condition) ++ "){" ++ jir_emit_return(book, yes) ++
        "}else{" ++ jir_emit_return(book, no) ++ "}"
    case other: "return " ++ jir_emit(book, other) ++ ";"

# Module: src/back/js/ir/statement.bend:21
@unsafe
def jir_statement_values(+book: List<&2,KDef>, +values: List<&2,JIRExpr>, +at: U32) -> String:
  match values:
    case Nil{}: ""
    case Con{value, rest}:
      "const $jir" ++ U32.show(at) ++ "=" ++ jir_emit(book, value) ++ ";" ++
        jir_statement_values(book, rest, U32.inc(at))

# Module: src/back/js/ir/statement.bend:29
@unsafe
def jir_statement_bindings(+params: List<&2,JIRParam>, +at: U32) -> String:
  match params:
    case Nil{}: ""
    case Con{param, rest}:
      "const " ++ j_local(jir_param_id(param)) ++ "=$jir" ++ U32.show(at) ++ ";" ++
        jir_statement_bindings(rest, U32.inc(at))

