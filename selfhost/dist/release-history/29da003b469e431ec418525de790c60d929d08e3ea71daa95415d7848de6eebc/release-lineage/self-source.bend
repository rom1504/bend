# Exact pinned compiler OWNED datatype set. User definitions remain valid for
# pure checking/normalization but cannot use the runtime's intrinsic layouts.

# Module: src/driver/api.bend:76
@unsafe
def driver_emit_owned(
  +book: List<&2,KDef>,
) -> String:
  +error = driver_owned_names(driver_owned_candidates(book), ["IO", "Sigma", "String", "Word.Con", "IO.OP", "Result", "Poll", "Maybe", "Bool", "Unit", "Nat", "U32", "F32", "Char", "Array"])
  kc(String, String.eq(error, ""), u => driver_foreign_names(book, book), u => error)

# Native definitions cannot violate the owned-name rule. Filter once instead
# of revisiting the same native prefix for each reserved name. Retain duplicates
# and source order; foreign/constructor policy still receives the original book.

# Module: src/driver/api.bend:86
@unsafe
def driver_owned_candidates(+book: List<&2,KDef>) -> List<&2,KDef>:
  match book:
    case Nil{}: Nil{}
    case Con{d, rest}: kc(List<&2,KDef>, db(d),
      u => driver_owned_candidates(rest), u => Con{d, driver_owned_candidates(rest)})

# Module: src/driver/api.bend:93
@unsafe
def driver_foreign_names(+book: List<&2,KDef>, +defs: List<&2,KDef>) -> String:
  match defs:
    case Nil{}: ""
    case Con{d, rest}:
      kc(String, kc(Bool, String.eq(dk(d), "Def") && String.eq(tg(j_strip(dv(d))), "Foreign"),
        u => Bool.not(String.eq(dk(j_find_ctor(book, dn(d))), "Absent")), u => False{}),
        u => name_key(dn(d)) ++ " names both a constructor and a foreign def: name one apart",
        u => driver_foreign_names(book, rest))

# Module: src/driver/api.bend:103
@unsafe
def driver_owned_names(book, names):
  match names:
    case Nil{}: ""
    case Con{name, rest}:
      kc(String, driver_owned_name(book, name),
        u => name_key(name) ++ " is a name the compiler encodes itself: name yours apart",
        u => driver_owned_names(book, rest))

# Module: src/driver/api.bend:112
@unsafe
def driver_owned_name(book, name):
  match book:
    case Nil{}: False{}
    case Con{d, rest}:
