  nt_choose(NC_Code, String.eq(tg(t), "NO_Loop"), u => no_emit_loop(t, env, params, n), u =>
  nt_choose(NC_Code, String.eq(tg(t), "NO_Let"), u => no_emit_let(t, env, params, layouts, n), u =>
