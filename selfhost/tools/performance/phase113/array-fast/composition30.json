  "pipelineDeclarations": {
    "p113d_lower_request": "@unsafe\ndef p113d_lower_request(request: NR_Request) -> P113DLowering:\n  p113k_lowered(p113i_lowered(p113pl_lower_request(request)))",
    "p113k_lowered": "@unsafe\ndef p113k_lowered(+lowered: P113DLowering) -> P113DLowering:\n  match lowered:\n    case P113DLowered{program,+error}:\n      nt_choose(P113DLowering,String.is_empty(error),u => P113DLowered{p113k_optimize(program),error},u => lowered)",
    "p113i_lowered": "@unsafe\ndef p113i_lowered(+lowered: P113DLowering) -> P113DLowering:\n  match lowered:\n    case P113DLowered{program,+error}:\n      nt_choose(P113DLowering,String.is_empty(error),\n        u => P113DLowered{p113i_optimize(program),error},u => lowered)",
    "p113i_function_done": "@unsafe\ndef p113i_function_done(+original: P113DFunction, +name: String, +params: List<&2,NC_Binding>, +result: U32, +public: Bool, scan: P113IScan) -> P113DFunction:\n  match scan:\n    case P113IScan{+body,next,budget}:\n      nt_choose(P113DFunction,U32.is_le(p113i_stack(body),16384),\n        u => p113k_function(P113DFunction{name,params,result,public,body}),u => original)",
    "p113i_eligible": "@unsafe\ndef p113i_eligible(function: P113DFunction) -> Bool:\n  match function:\n    case P113DFunction{name,+params,+result,public,+body}:\n      U32.is_ge(result,1) && U32.is_le(result,8) && U32.is_le(nt_count(NC_Binding,params),32) &&\n        U32.is_le(p113i_size(body),192) && U32.is_le(p113i_stack(body),8192) &&\n        p113i_params(params) && p113j_returns(body,result)",
    "p113i_function": "@unsafe\ndef p113i_function(+function: P113DFunction, +table: P113ITable) -> P113DFunction:\n  match function:\n    case P113DFunction{+name,+params,+result,+public,+body}:\n      nt_choose(P113DFunction,p113i_params(params) && p113i_clean(body) && U32.is_le(p113i_size(body),2048),\n        u => p113i_function_done(function,name,params,result,public,p113i_scan(body,table,0,512)),u => function)",
    "p113i_optimize": "@unsafe\ndef p113i_optimize(+program: P113DProgram) -> P113DProgram:\n  nt_choose(P113DProgram,String.is_empty(p113d_verify(program)),\n    u => p113i_verified(program,p113i_admitted(program)),u => program)",
    "p113k_optimize": "@unsafe\ndef p113k_optimize(+program: P113DProgram) -> P113DProgram:\n  nt_choose(P113DProgram,String.is_empty(p113d_verify(program)),\n    u => p113k_verified(program,p113k_admitted(program)),u => program)"
  },
