      u => Con{j_app_type(t, atom("Absent")), rest}, u => Con{kid(t, 0), Con{j_app_type(t, atom("Absent")), rest}}), seen, fuel), u =>
    kc(U32, String.eq(tg(t), "ADT"), u =>
