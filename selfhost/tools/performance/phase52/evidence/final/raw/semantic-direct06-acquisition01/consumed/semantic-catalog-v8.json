            [
              35
            ]
          ],
          "expected": {
            "$": "Packet",
            "payload": 35,
            "count": 7
          }
        },
        {
          "id": "adt-named-input",
          "exportName": "unpack",
          "groups": [
            [
              {
                "$": "Packet",
                "payload": 35,
                "count": 7
              }
            ]
          ],
          "expected": 42,
          "inputUnchanged": true
        },
        {
          "id": "adt-getter-order",
          "exportName": "unpack",
          "groups": [
            [
              {
                "$getters": {
                  "payload": {
                    "value": 35
                  },
                  "count": {
                    "value": 7
                  }
                },
                "value": {
                  "$": "Packet"
                }
              }
            ]
          ],
          "expected": 42
        },
        {
          "id": "adt-getter-throw",
          "exportName": "unpack",
          "groups": [
            [
              {
                "$getters": {
                  "payload": {
                    "throw": "payload-first"
                  },
                  "count": {
                    "throw": "count-second"
                  }
                },
                "value": {
                  "$": "Packet"
                }
              }
            ]
          ],
          "expectedError": "payload-first"
        },
        {
