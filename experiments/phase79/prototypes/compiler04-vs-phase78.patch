+# PRIVATE prepared native Base products. The host admits compiler/Base/graph
+# identity and the current disjoint successful checked world before attachment.
+# Ordinary/raw requests never infer this permission from source declarations.
+@unsafe
+def base_native_prepare(+prepared: KBasePreparedWorld, +minimumWork: U32) -> KBaseAnnotationState:
+  match prepared:
+    case KBasePreparedWorld{state, original, final, saved, checked, seen, todos, bound}:
+      nl_prepare_state(state, checked, minimumWork)
+
+@unsafe
+def nl_prepare_state(state: KBasePrefixState, +checked: List<&2,KDef>, +minimumWork: U32) -> KBaseAnnotationState:
+  match state:
+    case KBasePrefixState{bound, delta, stamp, patches, ready}:
+      kc(KBaseAnnotationState, ready, u => nl_prepare_closed(book_final_reverse(checked, Nil{}), minimumWork), u => KBaseAnnotationState{Nil{}, Nil{}})
+
+@unsafe
+def nl_prepare_closed(+checked: List<&2,KDef>, +minimumWork: U32) -> KBaseAnnotationState:
+  +context = book_context(checked)
+  kc(KBaseAnnotationState, base_prefix_closed(checked, context) &&
+    base_annotation_implicit(context, ["Nat", "U32", "F32", "String", "Char", "Bool", "Word", "List"]),
+    u => nl_prepare_defs(context, base_annotation_collect(context, checked, nc_annotation_stops(context), 0), minimumWork),
+    u => KBaseAnnotationState{Nil{}, Nil{}})
+
+@unsafe
+def nl_prepare_defs(+context: List<&2,KDef>, +defs: List<&2,KDef>, +minimumWork: U32) -> KBaseAnnotationState:
+  +book = nc_annotated_context(context, defs)
+  nl_prepare_closure(book, defs, nr_walk(book, base_annotation_keys(defs), Nil{}, Nil{}), minimumWork)
+
+@unsafe
+def nl_prepare_closure(+book: List<&2,KDef>, +defs: List<&2,KDef>, closure: NR_Closure, +minimumWork: U32) -> KBaseAnnotationState:
+  match closure:
+    case NR_Closure{+names, +facts}:
+      nl_prepare_workers(ns_prepare(ns_attach_book(book, facts, 0, Nil{}), names), defs, facts, names, minimumWork)
+
+@unsafe
+def nl_prepare_workers(+book: List<&2,KDef>, +defs: List<&2,KDef>, +facts: List<&2,KDef>, +names: List<&2,String>, +minimumWork: U32) -> KBaseAnnotationState:
+  +signatures = book_cached(nq_signatures(book, names), 0)
+  +workers = nl_store_workers(book, nf_candidates(book, names, Nil{}, signatures), signatures)
+  +payload : KDef = KDef{"$native.library", "NativeLibrary", 0, 0, atom("Absent"), atom("Absent"), [index_build(facts), index_build(workers)], False{}, False{}}
+  KBaseAnnotationState{nl_work_keys(defs, minimumWork), book_cached(Con{payload, defs}, 0)}
+
+@unsafe
+def nl_work_keys(defs: List<&2,KDef>, +minimumWork: U32) -> List<&2,String>:
+  match defs:
+    case Nil{}: Nil{}
+    case Con{+d, +rest}: kc(List<&2,String>, base_annotation_large([dv(d)], minimumWork),
+      u => Con{dn(d), nl_work_keys(rest, minimumWork)}, u => nl_work_keys(rest, minimumWork))
+
+@unsafe
+def nl_strings(values: List<&2,String>) -> List<&2,KTerm>:
+  match values:
+    case Nil{}: Nil{}
+    case Con{h, rest}: Con{kt("NativeName", h, 0, 0, Nil{}), nl_strings(rest)}
+
+@unsafe
+def nl_names(values: List<&2,KTerm>) -> List<&2,String>:
+  match values:
+    case Nil{}: Nil{}
+    case Con{h, rest}: Con{nm(h), nl_names(rest)}
+
+@unsafe
+def nl_params(params: List<&2,N_Param>) -> List<&2,KTerm>:
+  match params:
+    case Nil{}: Nil{}
+    case Con{N_Param{word, kind}, rest}: Con{kt("NativeParam", word, nl_kind(kind), 0, Nil{}), nl_params(rest)}
+
+@unsafe
+def nl_kind(kind: N_WordKind) -> U32:
+  match kind:
+    case N_W32{}: 1
+    case _: 0
+
+@unsafe
+def nl_decode_params(params: List<&2,KTerm>) -> List<&2,N_Param>:
+  match params:
+    case Nil{}: Nil{}
+    case Con{+h, rest}: Con{N_Param{nm(h), kc(N_WordKind, U32.is_eq(ix(h), 1), u => N_W32{}, u => N_W64{})}, nl_decode_params(rest)}
+
+# Snapshot all signature queries reachable from the compact body. Both function
+# and constructor queries are checked again, including retry withdrawal. No
+# negative lowering result, global segment ID or static image address is reused.
+@unsafe
+def nl_signature_inputs(ts: List<&2,KTerm>, +signatures: List<&2,KDef>) -> List<&2,KDef>:
+  match ts:
+    case Nil{}: Nil{}
+    case Con{+t, +rest}:
+      +more = nl_signature_inputs(nt_append(KTerm, ks(t), rest), signatures)
+      kc(List<&2,KDef>, String.eq(tg(t), "Ref") || String.eq(tg(t), "NFCall"),
+        u => Con{nl_signature_input(signatures, nm(t)), more},
+        u => kc(List<&2,KDef>, String.eq(tg(t), "Ctr") || String.eq(tg(t), "NCtr") || String.eq(tg(t), "NStatic"),
+          v => Con{nl_signature_input(signatures, "$constructor." ++ nm(t)), more}, v => more))
+
+@unsafe
+def nl_signature_input(+signatures: List<&2,KDef>, +name: String) -> KDef:
+  +d = lookup(signatures, name)
+  KDef{name, dk(d), da(d), dx(d), dt(d), dv(d), Nil{}, False{}, False{}}
+
+@unsafe
+def nl_store_workers(+book: List<&2,KDef>, workers: List<&2,NF_Worker>, +signatures: List<&2,KDef>) -> List<&2,KDef>:
+  match workers:
+    case Nil{}: Nil{}
+    case Con{NF_Worker{+name, +params, +code, +deps, +shape}, +rest}:
+      kc(List<&2,KDef>, String.is_empty(nc_error(code)) && List.is_empty(&2,N_Segment,nc_segs(code)) && Bool.not(String.contains(nc_body(code), "STAT_OFF")),
+        u => Con{KDef{name, "NativeLibraryWorker", nc_fresh(code), 0, shape,
+          kt("NativeCode", nc_body(code), 0, 0, [kt("Params", "", 0, 0, nl_params(params)), kt("Calls", "", 0, 0, nl_strings(deps))]),
+          nl_signature_inputs([nc_compact_definition(book, lookup(book, name), 0)], signatures), False{}, False{}}, nl_store_workers(book, rest, signatures)},
+        u => nl_store_workers(book, rest, signatures))
+
+@unsafe
+def nl_payload(+book: List<&2,KDef>) -> KDef:
+  nl_payload_children(dc(ns_context(book)))
+
+@unsafe
+def nl_payload_children(children: List<&2,KDef>) -> KDef:
+  match children:
+    case Con{bodies, Con{ctors, Con{product, rest}}}: product
+    case _: missing()
+
+@unsafe
+def nl_with(+book: List<&2,KDef>, +product: KDef) -> List<&2,KDef>:
+  match book:
+    case Nil{}: book
+    case Con{+cache, rest}:
+      +context = ns_context(book)
+      Con{KDef{dn(cache), dk(cache), da(cache), dx(cache), dt(cache), dv(cache),
+        [index_first(dc(cache)), KDef{dn(context), dk(context), da(context), dx(context), dt(context), dv(context),
+          [index_first(dc(context)), index_first(dc_tail(dc(context))), product], db(context), du(context)}], db(cache), du(cache)}, rest}
+
+@unsafe
+def dc_tail(ds: List<&2,KDef>) -> List<&2,KDef>:
+  match ds:
+    case Nil{}: Nil{}
+    case Con{head, tail}: tail
+
+@unsafe
+def nr_prepare_library(+book: List<&2,KDef>, +products: List<&2,KDef>) -> NR_Request:
+  +source = ns_source(book)
+  +product = lookup(products, "$native.library")
+  +seed = nl_with(ns_attach_book(source, Nil{}, 0, Nil{}), product)
+  nl_prepared_library(source, product, nr_walk(seed, ["main"], Nil{}, Nil{}))
+
+@unsafe
+def nl_prepared_library(+source: List<&2,KDef>, +product: KDef, closure: NR_Closure) -> NR_Request:
+  match closure:
+    case NR_Closure{+names, facts}:
+      NR_Request{source, nl_with(ns_attach_book(source, facts, 0, Nil{}), nl_selected(product, names)), names, nc_paths_of(source, names), kr_filter(source, names)}
+
+@unsafe
+def nl_erased(+book: List<&2,KDef>, +name: String) -> KDef:
+  index_find(index_first(dc(nl_payload(book))), name, index_hash(name, 2166136261), 32)
+
+@unsafe
+def nl_terms_same(a: List<&2,KTerm>, b: List<&2,KTerm>) -> Bool:
+  match a, b:
+    case Nil{}, Nil{}: True{}
+    case Con{+x, xs}, Con{+y, ys}: String.eq(tg(x), tg(y)) && String.eq(nm(x), nm(y)) && U32.is_eq(ix(x), ix(y)) && U32.is_eq(qt(x), qt(y)) && nl_terms_same(ks(x), ks(y)) && nl_terms_same(xs, ys)
+    case _, _: False{}
+
+@unsafe
+def nl_inputs_match(inputs: List<&2,KDef>, +signatures: List<&2,KDef>) -> Bool:
+  match inputs:
+    case Nil{}: True{}
+    case Con{+d, rest}:
+      +actual = lookup(signatures, dn(d))
+      String.eq(dk(d), dk(actual)) && nl_terms_same([dt(d), dv(d)], [dt(actual), dv(actual)]) && nl_inputs_match(rest, signatures)
+
+@unsafe
+def nl_candidate(+book: List<&2,KDef>, +name: String, +signatures: List<&2,KDef>) -> NF_Worker:
+  +d = index_find(index_first(dc_tail(dc(nl_payload(book)))), name, index_hash(name, 2166136261), 32)
+  kc(NF_Worker, String.eq(dk(d), "NativeLibraryWorker") && nl_inputs_match(dc(d), signatures),
+    u => NF_Worker{name, nl_decode_params(ks(kid(dv(d), 0))), NC_Code{nm(dv(d)), Nil{}, da(d), "", nl_names(ks(kid(dv(d), 1)))}, nl_names(ks(kid(dv(d), 1))), dt(d)},
+    u => nf_candidate_plain(book, name, signatures))
+
+# After erasure, retain only selected workers. Generic source-tree walks must
+# not repeatedly traverse an entire prepared library through private metadata.
+@unsafe
+def nl_selected(+product: KDef, +names: List<&2,String>) -> KDef:
+  KDef{"$native.library", "NativeLibrary", 0, 0, atom("Absent"), atom("Absent"),
+    [missing(), index_build(nl_select_workers(index_first(dc_tail(dc(product))), names))], False{}, False{}}
+
+@unsafe
+def nl_select_workers(+workers: KDef, names: List<&2,String>) -> List<&2,KDef>:
+  match names:
+    case Nil{}: Nil{}
+    case Con{+name, +rest}:
+      +d = index_find(workers, name, index_hash(name, 2166136261), 32)
+      kc(List<&2,KDef>, String.eq(dk(d), "NativeLibraryWorker"),
+        u => Con{d, nl_select_workers(workers, rest)}, u => nl_select_workers(workers, rest))
