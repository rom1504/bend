+# Caller locals now own every result. Do not retain the last aggregate child
+# in the long-lived root closure after its transport register was consumed.
+@unsafe
+def jw_values_clear(+slots: List<&2,U32>, +at: U32) -> String:
+  match slots:
+    case Nil{}: ""
+    case Con{slot, rest}: kc(String, U32.is_eq(at, 0), u => "", u =>
+      "$workerValue" ++ U32.show(at) ++ "=undefined;") ++ jw_values_clear(rest, U32.inc(at))
