# Evaluated atoms do not need a continuation. Keep the same sharing and dead
# value handling as the general cut, and bind the word before lowering the body.

# Module: src/back/native/bridge.bend:231
@unsafe
def nc_let_atom(+book: List<&2, KDef>, +value: KTerm, +body: KTerm, +env: List<&2, NC_Binding>, +id: U32, +n: U32) -> NC_Code:
  +word = nt_choose(String, String.eq(tg(value), "Var"), u => nc_word(ix(value), env), u => nt_choose(String, String.eq(tg(value), "NOp"), u => nd_scalar_word(nm(value), nc_values(ks(value), env)), u => nt_choose(String, String.eq(tg(value), "NStatic"), v => ns_word(value), v => nm(value) ++ "ull")))
  +bodyUses = nc_uses(body)
  +held = nc_live_uses(env, bodyUses)
  +rest = nc_lower_partition(book, body, n, NC_Scheduler{}, nc_partition_uses(List.append(&2, NC_Binding, held, [nk_binding(id, value, env)]), bodyUses))
  nt_choose(NC_Code, String.eq(word, "NATIVE_UNBOUND_VARIABLE"),
    u => nc_let_cut(book, value, body, env, id, n),
    u => nc_prepend(nc_keep_uses(nc_live_env(env, value), bodyUses) ++ "Term v_" ++ U32.show(id) ++ " = " ++ word ++ ";\nif (!seq && err_seen(e.mem)) { return 0; }\n", rest))

# Module: src/back/native/bridge.bend:241
@unsafe
def nc_let(+book: List<&2, KDef>, +value: KTerm, +body: KTerm, +env: List<&2, NC_Binding>, +id: U32, +n: U32) -> NC_Code:
  +scalar = nd_scalar_call(book, value)
  nt_choose(NC_Code, String.eq(tg(value), "Var") || String.eq(tg(value), "NWord") || (String.eq(tg(value), "NStatic") && String.eq(dk(ns_context(book)), "NativeStaticContext")) || (String.eq(tg(value), "NOp") && nd_scalar_known(nm(value))),
    u => nc_let_atom(book, value, body, env, id, n),
    u => nt_choose(NC_Code, String.eq(scalar, ""),
      u => nc_let_value(book, value, body, env, id, n),
      u => nc_lower(book, nd_bind_scalar(scalar, nd_args(value, Nil{}), Nil{}, n, id, body), env, U32.add(n, terms_len(nd_args(value, Nil{}))))))

# A local value producer owns its scratch C scope and evaluates exactly once.
# Only the boxed word escapes; neither allocation nor ownership is erased.

# Module: src/back/native/bridge.bend:252
@unsafe
def nc_let_emitted(+book: List<&2, KDef>, +value: KTerm, +body: KTerm, +env: List<&2, NC_Binding>, +id: U32, emitted: N_Emitted) -> NC_Code:
