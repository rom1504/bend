        u => kt("NWord", nt_choose(String, String.eq(nm(t), "True"), v => "1", v => "0"), 0, 0, Nil{}), u => t)
    case Con{+h, Nil{}}:
      nt_choose(KTerm, String.eq(nm(t), "Chr") && String.eq(tg(h), "NWord"), u => h, u => t)
