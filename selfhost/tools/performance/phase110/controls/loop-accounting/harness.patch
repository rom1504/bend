+/* Versioned instrumentation only: semantic operations retain their order.
+ * The original double worker clock remains verbatim inside the worker envelope.
+ * Phase marks partition one continuous interval; independent outer marks
+ * expose instrumentation/entry/exit residual instead of hiding it in worker time.
+ */
+enum { PH_OPEN, PH_SETUP, PH_WORKER, PH_PENDING, PH_OBSERVE, PH_DROP,
+       PH_ACCOUNT_CLOSE, PH_BOOKKEEPING, PH_COUNT };
+static uint64_t account_now_ns(void) {
+  struct timespec t;
+  require(clock_gettime(CLOCK_MONOTONIC, &t) == 0, "accounting clock failed");
+  return (uint64_t)t.tv_sec * UINT64_C(1000000000) + (uint64_t)t.tv_nsec;
+}
+static void account_phase(uint64_t totals[PH_COUNT], uint64_t *last, uint32_t phase) {
+  uint64_t end = account_now_ns();
+  require(end >= *last, "accounting clock moved backwards");
+  totals[phase] += end - *last;
+  *last = end;
+}
