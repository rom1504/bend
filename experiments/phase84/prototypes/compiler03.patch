diff --git a/selfhost/src/driver/report.bend b/selfhost/src/driver/report.bend
index 0c5eb15..82b2d37 100644
--- a/selfhost/src/driver/report.bend
+++ b/selfhost/src/driver/report.bend
@@ -154,3 +154,20 @@ def dr_cached_step(+book: List<&2, KDef>, +name: String, +rest: List<&2, String>
     case DR_Closure{+bad, +seen}:
       kc(List<&2, String>, bad, u => Con{name, dr_cached_names(book, rest, safe)},
         u => dr_cached_names(book, rest, dr_mark_safe(seen, safe)))
+
+# PRIVATE ordinary-driver path. The certified Base index is already present in
+# the existing loader state. Overlay the exact freshened source suffix: parser
+# terms before freshening may still contain FGlobal, so cannot supply this query.
+# Existing public report APIs and unready source loads retain their old path.
+@unsafe
+def driver_report_prefix_data(+book: List<&2, KDef>, +load: FPrefixLoad, +state: FReadyPrefixState) -> DR_Report:
+  match load state:
+    case FPrefixLoad{trace, prefix, suffix, complete} FReadyPrefixState{names, ctors, count, ready}:
+      kc(DR_Report, complete && ready,
+        u => dr_prefix_report(book, suffix, names), u => driver_report_data(book))
+
+@unsafe
+def dr_prefix_report(+book: List<&2, KDef>, +suffix: List<&2, KDef>, +index: KDef) -> DR_Report:
+  +context: List<&2, KDef> = Con{KDef{"$kernel.cache", "BookCache", 0, 0, atom("Absent"), atom("Absent"), [f_prefix_names_extend(suffix, index)], True{}, False{}}, book}
+  +names = dr_cached_names(context, dr_own_names(book, Nil{}), missing())
+  DR_Report{dr_verdict(names), names}
