+@unsafe
+def w12_i_dead_tail(+name: String, tail: List<&2,List<&2,P113DStmt>>, +fuel: U32) -> Bool:
+  match tail:
+    case Nil{}: True{}
+    case Con{head,rest}: w12_i_dead_in(name,head,rest,fuel)
+
+@unsafe
+def w12_i_dead_step(+name: String, body: List<&2,P113DStmt>, +tail: List<&2,List<&2,P113DStmt>>, +fuel: U32) -> Bool:
+  match body:
+    case Nil{}: w12_i_dead_tail(name,tail,U32.sub(fuel,1))
+    case Con{P113DIf{cond,yes,no},+rest}:
+      +half = U32.div(fuel,2)
+      nt_choose(Bool,w2_val_reads(name,cond),v => False{},
+        v => w12_i_dead_in(name,yes,Con{rest,tail},half) &&
+             w12_i_dead_in(name,no,Con{rest,tail},half))
+    case Con{+stmt,rest}:
+      nt_choose(Bool,w2_dstmt_reads(name,stmt),v => False{},
+        v => nt_choose(Bool,w2_dstmt_terminal(stmt) || w2_dstmt_writes(name,stmt),w => True{},
+          w => w12_i_dead_in(name,rest,tail,U32.sub(fuel,1))))
+
+@unsafe
+def w12_i_dead_in(name,body,tail,fuel):
+  nt_choose(Bool,U32.is_eq(fuel,0),u => False{},u => w12_i_dead_step(name,body,tail,fuel))
