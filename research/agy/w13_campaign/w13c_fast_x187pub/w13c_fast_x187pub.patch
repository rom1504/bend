+        u => w13c_apply_code(x181_binary(name,typ,op,left,right,ids,frame,X181Code{[],next,term,""}),st))
+    case N111Offset{+name,+base,+bytes} W13cSt{+build,+lsyms,+lrelocs,+next,+term}:
