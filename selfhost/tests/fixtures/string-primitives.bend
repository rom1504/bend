import Base

def contains(+a: String, +b: String) -> Bool:
  String.contains(a, b)

def starts_with(+a: String, +b: String) -> Bool:
  String.starts_with(a, b)

def reverse(+a: String) -> String:
  String.reverse(a)

def is_empty(+a: String) -> Bool:
  String.is_empty(a)

def length(+a: String) -> Nat:
  String.length(a)
