+          +mask = U32.sub(U32.shln(1,U32.to_nat(cls)),1)
+          +aOut = nt_choose(String,U32.is_eq(off0,0),v => l0,v => l1)
+          +vOut = nt_choose(String,U32.is_eq(off0,0),v => l1,v => l0)
