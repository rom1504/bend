      "sha256": "c4fa10e9c7dcbb5d1ed6a34ca44d11d8412a09509265e847d1742a8dc329ba5a",
      "text": "type N_WordKind is Data:\n  N_W32{}\n  N_W64{}\n  N_Box{}\n"
    },
    {
      "name": "NC_Binding",
      "kind": "type",
      "lineStart": 598,
      "bytes": 82,
      "sha256": "e51a5eebe6ef7e7587c818e0f77a51caf2964c5519994c3933d36ff5cfd00595",
      "text": "type NC_Binding is Data:\n  NC_Binding{+id: U32, +word: String, +kind: N_WordKind}\n"
    },
    {
      "name": "nk_typed_bindings",
      "kind": "def",
      "lineStart": 31190,
      "bytes": 278,
      "sha256": "40e00a75a0f04ebd541b829e917f8c27201276fec29b9a3dc1f7b365e2f9819b",
      "text": "def nk_typed_bindings(params: List<&2, NC_Binding>, kinds: List<&2, N_WordKind>) -> List<&2, NC_Binding>:\n  match params, kinds:\n    case Con{NC_Binding{id, word, old}, rest}, Con{kind, more}: Con{NC_Binding{id, word, kind}, nk_typed_bindings(rest, more)}\n    case _, _: params\n"
    },
    {
      "name": "nl_c_type",
      "kind": "def",
      "lineStart": 31161,
      "bytes": 186,
      "sha256": "af0d588a222d6c4d5b04c21519e2ef633f1e0beab736b8dfa4572da28a6cbb8b",
      "text": "def nl_c_type(+k: N_WordKind) -> String:\n  match k:\n    case N_W32{}: \"#if !DEVICE && NATIVE_TYPED_SCALARS\\nu32\\n#else\\nTerm\\n#endif\\n\"\n    case N_W64{}: \"Term\"\n    case N_Box{}: \"Term\"\n"
    },
    {
      "name": "nf_param_type",
      "kind": "def",
      "lineStart": 33283,
      "bytes": 110,
      "sha256": "0f3eddbb5d2d50757b09463be8276329d3f179a6c92d8ff09616b6bdb90b1807",
      "text": "def nf_param_type(kind: N_WordKind) -> String:\n  match kind:\n    case N_W32{}: \"NF_SCALAR\"\n    case _: \"Term\"\n"
    }
  ],
