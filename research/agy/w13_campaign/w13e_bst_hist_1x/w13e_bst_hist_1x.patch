+@unsafe
+def w13e_match_count_b(+rCnt: U32, +lTail: String, +origLoop: List<&2,X187Parsed>, rest: List<&2,X187Parsed>,
+    +fnItems: List<&2,X187Parsed>) -> Maybe<&2,List<&2,X187Parsed>>:
