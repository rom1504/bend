+
+# All binder occurrences for one immutable body. The two persistent sets encode
+# counts 0/1/many; sequential visits update them and alternative branches union
+# them. This shares the backend's existing compact U32-key representation.
+type NQ_Counts is Data:
+  NQ_Counts{+used: NU_Set, +many: NU_Set}
+
+law nq_counts_walk:
+  for +t: KTerm
+  for +counts: NQ_Counts
+  NQ_Counts
+
+@unsafe
+def nq_count_get(+counts: NQ_Counts, +id: U32) -> U32:
+  match counts:
+    case NQ_Counts{used, many}: nt_choose(U32, nu_has(many, id), u => 2, u => nt_bool(nu_has(used, id)))
+
+@unsafe
+def nq_count_add(+counts: NQ_Counts, +id: U32) -> NQ_Counts:
+  match counts:
+    case NQ_Counts{+used, +many}:
+      nt_choose(NQ_Counts, nu_has(many, id), u => counts, u =>
+        nt_choose(NQ_Counts, nu_has(used, id), v => NQ_Counts{used, nu_add(many, id)}, v => NQ_Counts{nu_add(used, id), many}))
+
+@unsafe
+def nq_count_union(+a: NU_Set, +b: NU_Set) -> NU_Set:
+  match a:
+    case NU_Empty{}: b
+    case NU_Leaf{key}: nu_add(b, key)
+    case NU_Node{mask, left, right}: nq_count_union(left, nq_count_union(right, b))
+
+@unsafe
+def nq_count_join(+a: NQ_Counts, +b: NQ_Counts) -> NQ_Counts:
+  match a b:
+    case NQ_Counts{au, am} NQ_Counts{bu, bm}: NQ_Counts{nq_count_union(au, bu), nq_count_union(am, bm)}
+
+@unsafe
+def nq_counts_list(ts: List<&2,KTerm>, +counts: NQ_Counts) -> NQ_Counts:
+  match ts:
+    case Nil{}: counts
+    case Con{h, rest}: nq_counts_list(rest, nq_counts_walk(h, counts))
+
+@unsafe
+def nq_counts_rows(rows: List<&2,KTerm>, +counts: NQ_Counts) -> NQ_Counts:
+  match rows:
+    case Nil{}: counts
+    case Con{row, rest}: nq_count_join(nq_counts_walk(kid(row, 0), counts), nq_counts_rows(rest, counts))
+
+@unsafe
+def nq_counts_walk(t, counts):
+  nt_choose(NQ_Counts, String.eq(tg(t), "Var"), u => nq_count_add(counts, ix(t)), u =>
+    nt_choose(NQ_Counts, String.eq(tg(t), "Mat") && U32.is_eq(terms_len(ks(t)), 2),
+      v => nq_count_join(nq_counts_walk(kid(t, 0), counts), nq_counts_walk(kid(t, 1), counts)),
+      v => nt_choose(NQ_Counts, String.eq(tg(t), "NWPattern"), w => nq_counts_rows(ks(t), counts), w => nq_counts_list(ks(t), counts))))
+
+@unsafe
+def nq_counts(+t: KTerm) -> NQ_Counts:
+  nq_counts_walk(t, NQ_Counts{NU_Empty{}, NU_Empty{}})
