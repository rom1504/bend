+import Base
+
+# Successful output only: the chronological semantic world retains source terms.
+# Retained types are resolved in the final book, never normalized early and cached.
+@unsafe
+def ki_typed(+dem: U32, +r: KChecking) -> KChecking:
+  kc(KChecking, good(r) && Bool.not(U32.is_eq(dem, 0)), u => KChecking{kt("Ann", "$kernel.typed", 0, 0, [strip(ct(r)), cy(r)]), cy(r), cs(r), "", rw(r), rx(r)}, u => r)
+
+@unsafe
+def ki_is_typed(+t: KTerm) -> Bool:
+  String.eq(tg(t), "Ann") && String.eq(nm(t), "$kernel.typed")
+
+@unsafe
+def ki_field_result(+q: U32, +r: KChecking) -> KChecking:
+  kc(KChecking, good(r), u => KChecking{kt("Ann", "$kernel.typed", 1, q, [strip(ct(r)), cy(r)]), cy(r), cs(r), "", rw(r), rx(r)}, u => r)
+
+law ki_readback:
+  for +book: List<&2,KDef>
+  for +t: KTerm
+  KTerm
+
+law ki_readback_node:
+  for +book: List<&2,KDef>
+  for +t: KTerm
+  KTerm
+
+law ki_readback_terms:
+  for +book: List<&2,KDef>
+  for +ts: List<&2,KTerm>
+  List<&2,KTerm>
+
+law ki_raw:
+  for +t: KTerm
+  KTerm
+
+law ki_raw_terms:
+  for +ts: List<&2,KTerm>
+  List<&2,KTerm>
+
+@unsafe
+def ki_readback(book, t):
+  kc(KTerm, ki_is_typed(t),
+    u => kt("Ann", "", ix(t), qt(t), [ki_readback_node(book, kid(t, 0)), wnf(book, kid(t, 1))]),
+    u => ki_readback_node(book, t))
+
+@unsafe
+def ki_readback_node(book, t):
+  kc(KTerm, core_literal(t), u => t,
+    u => kc(KTerm, String.eq(tg(t), "Lam"), u => k_lam(nm(t), ix(t), qt(t), [ki_readback(book, kid(t, 0))], 0, 0, False{}),
+    u => kc(KTerm, String.eq(tg(t), "App"), u => app(ki_readback(book, kid(t, 0)), ki_readback(book, kid(t, 1))),
+    u => kc(KTerm, String.eq(tg(t), "Ctr") || String.eq(tg(t), "Mat") || String.eq(tg(t), "Let") || String.eq(tg(t), "Bind"),
+      u => kt(tg(t), nm(t), ix(t), qt(t), ki_readback_terms(book, ks(t))),
+    u => kc(KTerm, String.eq(tg(t), "Rwt"), u => kt("Rwt", nm(t), ix(t), qt(t), [ki_readback(book, kid(t, 0)), ki_raw(kid(t, 1)), ki_readback(book, kid(t, 2))]),
+    u => ki_raw(t))))))
+
+@unsafe
+def ki_readback_terms(book, ts):
+  match ts:
+    case Nil{}: Nil{}
+    case Con{h, rest}: Con{ki_readback(book, h), ki_readback_terms(book, rest)}
+
+@unsafe
+def ki_raw(t):
+  kc(KTerm, ki_is_typed(t), u => ki_raw(kid(t, 0)),
+    u => kc(KTerm, core_literal(t) || List.is_empty(&2, KTerm, ks(t)), u => t,
+    u => k_with_children(t, ki_raw_terms(ks(t)))))
+
+@unsafe
+def ki_raw_terms(ts):
+  match ts:
+    case Nil{}: Nil{}
+    case Con{h, rest}: Con{ki_raw(h), ki_raw_terms(rest)}
+
+# A prepared prefix may not export checking-local fresh binders into a suffix.
+# Retain the existing admission invariant, falling back per definition if a
+# retained type mentions a binder minted beyond the source prefix's bound.
+@unsafe
+def ki_prefix_defs(+ds: List<&2,KDef>, +bound: U32) -> List<&2,KDef>:
+  match ds:
+    case Nil{}: Nil{}
+    case Con{d, rest}: Con{kc(KDef, U32.is_le(norm_max_term(dv(d)), bound), u => d,
+      u => KDef{dn(d), dk(d), da(d), dx(d), dt(d), ki_raw(dv(d)), dc(d), db(d), du(d)}), ki_prefix_defs(rest, bound)}
