{
  "kind": "phase112-raw-scalar-controls",
  "version": 1,
  "targetsRun": false,
  "scope": "Raw machine-word checks supplement checked-source fixtures; they are not claims that these high-half words are canonical source U32 values.",
  "encoding": "Each operand and expected value is [lo32,hi32]. Expected integers are independently specified.",
  "cases": [
    {"name":"high-add","op":"u32_add","args":[[5,1],[7,2]],"expected":[12,0]},
    {"name":"high-sub-wrap","op":"u32_sub","args":[[0,4294967295],[1,1]],"expected":[4294967295,0]},
    {"name":"high-multiply","op":"u32_mul","args":[[4294967295,4294967295],[4294967295,1]],"expected":[1,0]},
    {"name":"high-and","op":"u32_and","args":[[2863311530,1],[1431655765,4294967295]],"expected":[0,0]},
    {"name":"high-or","op":"u32_or","args":[[2863311530,1],[1431655765,2]],"expected":[4294967295,0]},
    {"name":"high-xor","op":"u32_xor","args":[[5,1],[5,2]],"expected":[0,0]},
    {"name":"high-equal","op":"u32_is_eq","args":[[5,1],[5,2]],"expected":[1,0]},
    {"name":"high-not-unequal","op":"u32_is_ne","args":[[5,1],[5,2]],"expected":[0,0]},
    {"name":"unsigned-less","op":"u32_is_lt","args":[[2147483647,4294967295],[2147483648,0]],"expected":[1,0]},
    {"name":"equal-less-equal","op":"u32_is_le","args":[[2147483648,2],[2147483648,1]],"expected":[1,0]},
    {"name":"unsigned-greater","op":"u32_is_gt","args":[[2147483648,0],[2147483647,4294967295]],"expected":[1,0]},
    {"name":"high-greater-equal-false","op":"u32_is_ge","args":[[0,4294967295],[4294967295,0]],"expected":[0,0]},
    {"name":"high-increment-wrap","op":"u32_inc","args":[[4294967295,4294967295]],"expected":[0,0]},
    {"name":"high-fixed-left","op":"u32_shl","args":[[2147483648,4294967295]],"expected":[0,0]},
    {"name":"high-fixed-right","op":"u32_shr","args":[[2147483648,4294967295]],"expected":[1073741824,0]},
    {"name":"high-variable-left-zero","op":"u32_shln","args":[[5,4294967295],[0,0]],"expected":[5,0]},
    {"name":"full-count-left","op":"u32_shln","args":[[1,0],[0,1]],"expected":[0,0]},
    {"name":"full-count-right","op":"u32_shrn","args":[[4294967295,0],[0,1]],"expected":[0,0]},
    {"name":"max-count-left","op":"u32_shln","args":[[1,0],[4294967295,4294967295]],"expected":[0,0]},
    {"name":"high-variable-right","op":"u32_shrn","args":[[2147483648,4294967295],[31,0]],"expected":[1,0]},
    {"name":"high-not","op":"u32_not","args":[[0,4294967295]],"expected":[4294967295,0]},
    {"name":"high-is-zero","op":"u32_is_zero","args":[[0,1]],"expected":[1,0]},
    {"name":"fallback-div-zero","op":"u32_div","args":[[7,2],[0,1]],"expected":[0,0]},
    {"name":"fallback-mod-zero-keeps-high","op":"u32_mod","args":[[7,2],[0,1]],"expected":[7,2]}
  ],
  "structuralControls": [
    {"op":"u32_add","args":[],"expect":"unchanged p111_rt_op fallback with count0"},
    {"op":"u32_add","args":[{"lo":1,"hi":0}],"expect":"unchanged p111_rt_op fallback with count1"},
    {"op":"u32_inc","args":[{"lo":1,"hi":0},{"lo":2,"hi":0}],"expect":"unchanged p111_rt_op fallback with count2"},
    {"op":"unknown_scalar","args":[],"expectError":"unknown native primitive unknown_scalar"},
    {"op":"u32_add","args":[{"local":"p112_s_a"},{"local":"value"}],"expect":"unchanged runtime fallback"},
    {"op":"u32_sub","args":[{"local":"value"},{"local":"p112_s_b"}],"expect":"unchanged runtime fallback"},
    {"op":"u32_is_eq","args":[{"local":"p112_s_test"},{"lo":0,"hi":0}],"expect":"unchanged runtime fallback"},
    {"op":"u32_add","args":[{"local":"value"},{"local":"value"}],"expect":"direct specialization snapshots both operands before assigning value"},
    {"op":"u32_cmp","args":[{"lo":0,"hi":0},{"lo":1,"hi":0}],"expect":"unchanged tagged-Cmp runtime fallback"},
    {"op":"f32_add","args":[{"lo":1065353216,"hi":0},{"lo":1065353216,"hi":0}],"expect":"unchanged float runtime fallback"}
  ]
}
