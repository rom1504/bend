    {
      "name": "run_loop",
      "sha256": "6699dae5e25915e22e46d0b837caa536dbbd3c7e5758cbade7067037ae438269",
      "bytes": 124,
      "historicalSha256": "b1f937dcb68edc1033b01d5a6055938ec2e34103bacd41b68c36f2ea66bd1c8f",
      "exactHistoricalBody": false,
      "body": "function run_loop(r) {\n  while (r !== null && typeof r === \"object\" && r.$ === \"$JMP\") {\n    r = r.f(r.x);\n  }\n  return r;\n}"
    },
    {
      "name": "run_tail",
      "sha256": "a1796267325ff93e0436714616dfba3a605b6c7f40b1e54c156ca6754d5ec9b5",
      "bytes": 79,
      "historicalSha256": "72aa8e5b23785a67a6b6a2fb3ad46a94bf9b77764c4c3b8296033031eed62ff6",
      "exactHistoricalBody": false,
      "body": "function run_tail(f, x) {\n  return {$: \"$JMP\", f: f.j?.f === f ? f.j : f, x};\n}"
    },
    {
      "name": "run_clo",
      "sha256": "23d2a048610410013d7c84561a9111e39fe7a5380568c0fb021d9485ef1a05e6",
      "bytes": 92,
      "historicalSha256": "23d2a048610410013d7c84561a9111e39fe7a5380568c0fb021d9485ef1a05e6",
      "exactHistoricalBody": true,
      "body": "function run_clo(j) {\n  const f = (x) => run_loop(j(x));\n  f.j = j;\n  j.f = f;\n  return f;\n}"
    },
