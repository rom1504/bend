    case Nil{}: True{}
    case Con{shape, rest}:
      nt_choose(Bool, String.eq(tg(shape), "NQShape"), u => nq_demand(nd_reapply(body, args), nc_id(i), 64), u => True{}) && nq_entry_demand(body, rest, args, U32.inc(i))

