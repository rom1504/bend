{
  "name": "bend2-compiler-port",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node tools/build/hosted.mjs acquire",
    "bootstrap": "node tools/build/hosted.mjs acquire",
    "test": "node tools/smoke.mjs",
    "survey": "node tools/conformance/run.mjs --adapter tools/conformance/adapters/typed.mjs",
    "check-fixtures": "node tools/check-fixtures.mjs",
    "bootstrap:typed": "node tools/build/hosted.mjs acquire",
    "bootstrap:self": "node --stack-size=4096 --max-old-space-size=4096 tools/build/js-bootstrap.mjs",
    "bootstrap:native": "python3 -B tools/build/bootstrap.py",
    "assemble": "node tools/assemble.mjs",
    "verify": "node --stack-size=4096 --max-old-space-size=4096 tools/verify.mjs",
    "test:runtime": "node src/runtime/js/test.mjs",
    "test:abi": "node tools/test-compiler-abi.mjs",
    "test:harness": "node --test tests/conformance/*.test.mjs tests/native-build.test.mjs",
    "test:source": "python3 -B tests/consolidation/source.py --stage .",
    "test:build": "python3 -B tools/build/test_build.py",
    "test:self": "node tools/selfcheck.mjs",
    "conformance": "node tools/conformance/run.mjs --adapter tools/conformance/adapters/typed.mjs",
    "build": "python3 -B tools/build/native.py",
    "build:native": "python3 -B tools/build/native.py",
    "release": "python3 -B tools/build/release.py install",
    "release:audit": "python3 -B tools/build/release.py audit",
    "verify:release": "python3 -B tools/build/release.py verify --manifest manifests/current.json"
  }
}
